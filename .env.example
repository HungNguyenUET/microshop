# Copy thanh .env roi dien gia tri that (file .env da nam trong .gitignore)
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
#   Homepage URL:               http://localhost:8080
#   Authorization callback URL: http://localhost:9000/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub username (cach nhau bang dau phay) duoc cap quyen ADMIN khi login lan dau
ADMIN_GITHUB_LOGINS=
